#[discard, doc("Takes the passed in text(t) wraps in bold ANSI escape code and returns")]
fn make_bold(t string) -> string {
    return "${BOLD}${t}${RESET}"
}

#[discard, doc("Takes the passed in text(t) wraps in dim ANSI escape code and returns")]
fn make_dim(t string) -> string {
    return "${DIM}${t}${RESET}"
}

#[discard, doc("Takes the passed in text(t) wraps in italic ANSI escape code and returns")]
fn make_italic(t string) -> string {
    return "${ITALIC}${t}${RESET}"
}

#[discard, doc("Takes the passed in text(t) wraps in underline ANSI escape code and returns")]
fn make_underline(t string) -> string {
    return "${UNDERLINE}${t}${RESET}"
}

#[discard, doc("Takes the passed in text(t) wraps in reverse ANSI escape code and returns")]
fn make_reverse(t string) -> string {
    return "${REVERSE}${t}${RESET}"
}

#[discard, doc("Takes the passed in text(t) wraps in strick ANSI escape code and returns")]
fn make_strike(t string) -> string {
    return "${STRIKE}${t}${RESET}"
}

#[discard, doc("Resets text")]
fn reset() -> string {
	return RESET
}
