/*********************************
SPEED CONSTANTS
*********************************/
const KMH_PER_MPS f64 = 3.6
const MPS_PER_KMH f64 = 0.277778
const FPS_PER_MPH f64 = 1.46667
const MPH_PER_FPS f64 = 0.681818
const KMH_PER_MPH f64 = 1.60934
const MPH_PER_KMH f64 = 0.621371
const MPS_PER_MPH f64 = 0.44704
const MPH_PER_MPS f64 = 2.23694
const MPS_PER_FPS f64 = 0.3048
const FPS_PER_MPS f64 = 3.28084
const KMH_PER_KNOT f64 = 1.852
const KNOTS_PER_KMH f64 = 0.539957
const MPH_PER_KNOT f64 = 1.15078
const KNOTS_PER_MPH f64 = 0.868976
const MPS_PER_KNOT f64 = 0.514444
const KNOTS_PER_MPS f64 = 1.94384

/*********************************
METRIC TO METRIC CONVERSION FUNCTIONS
*********************************/
#[doc("Converts the passed meters per second(val) to kilometers per hour")]
fn meters_per_second_to_kilometers_per_hour(val f64) -> f64 {return val * KMH_PER_MPS}

#[doc("Converts the passed kilometers per hour(val) to meters per second")]
fn kilometers_per_hour_to_meters_per_second(val f64) -> f64 {return val * MPS_PER_KMH}


/*********************************
IMPERIAL TO IMPERIAL CONVERSION FUNCTIONS
*********************************/
#[doc("Converts the passed miles per hour(val) to feet per second")]
fn miles_per_hour_to_feet_per_second(val f64) -> f64 {return val * FPS_PER_MPH}

#[doc("Converts the passed feet per second(val) to miles per hour")]
fn feet_per_second_to_miles_per_hour(val f64) -> f64 {return val * MPH_PER_FPS}


/*********************************
IMPERIAL TO METRIC CONVERSION FUNCTIONS
*********************************/
#[doc("Converts the passed miles per hour(val) to kilometers per hour")]
fn miles_per_hour_to_kilometers_per_hour(val f64) -> f64 {return val * KMH_PER_MPH}

#[doc("Converts the passed miles per hour(val) to meters per second")]
fn miles_per_hour_to_meters_per_second(val f64) -> f64 {return val * MPS_PER_MPH}

#[doc("Converts the passed feet per second(val) to meters per second")]
fn feet_per_second_to_meters_per_second(val f64) -> f64 {return val * MPS_PER_FPS}

#[doc("Converts the passed feet per second(val) to kilometers per hour")]
fn feet_per_second_to_kilometers_per_hour(val f64) -> f64 {return val * MPS_PER_FPS * KMH_PER_MPS}


/*********************************
METRIC TO IMPERIAL CONVERSION FUNCTIONS
*********************************/
#[doc("Converts the passed kilometers per hour(val) to miles per hour")]
fn kilometers_per_hour_to_miles_per_hour(val f64) -> f64 {return val * MPH_PER_KMH}

#[doc("Converts the passed meters per second(val) to miles per hour")]
fn meters_per_second_to_miles_per_hour(val f64) -> f64 {return val * MPH_PER_MPS}

#[doc("Converts the passed meters per second(val) to feet per second")]
fn meters_per_second_to_feet_per_second(val f64) -> f64 {return val * FPS_PER_MPS}

#[doc("Converts the passed kilometers per hour(val) to feet per second")]
fn kilometers_per_hour_to_feet_per_second(val f64) -> f64 {return val * MPS_PER_KMH * FPS_PER_MPS}


/*********************************
KNOT CONVERSION FUNCTIONS
*********************************/
#[doc("Converts the passed knots(val) to kilometers per hour")]
fn knot_to_kilometers_per_hour(val f64) -> f64 {return val * KMH_PER_KNOT}

#[doc("Converts the passed kilometers per hour(val) to knots")]
fn kilometers_per_hour_to_knot(val f64) -> f64 {return val * KNOTS_PER_KMH}

#[doc("Converts the passed knots(val) to miles per hour")]
fn knot_to_miles_per_hour(val f64) -> f64 {return val * MPH_PER_KNOT}

#[doc("Converts the passed miles per hour(val) to knots")]
fn miles_per_hour_to_knot(val f64) -> f64 {return val * KNOTS_PER_MPH}

#[doc("Converts the passed knots(val) to meters per second")]
fn knot_to_meters_per_second(val f64) -> f64 {return val * MPS_PER_KNOT}

#[doc("Converts the passed meters per second(val) to knots")]
fn meters_per_second_to_knot(val f64) -> f64 {return val * KNOTS_PER_MPS}
