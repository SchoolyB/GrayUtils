#[doc("Converts the passed kilometers per hour(val) to feet per second")]
fn kilometers_per_hour_to_feet_per_second(val f64) -> (f64, Error) {
    mut err = validate_speed(val)
    if err != nil {
        return MIN_SPEED_VALUE, err
    }
    return val * MPS_PER_KMH * FPS_PER_MPS, nil
}


/*********************************
KNOT CONVERSION FUNCTIONS
*********************************/
#[doc("Converts the passed knots(val) to kilometers per hour")]
fn knot_to_kilometers_per_hour(val f64) -> (f64, Error) {
    mut err = validate_speed(val)
    if err != nil {
