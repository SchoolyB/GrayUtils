#[doc("Converts the passed miles(val) to feet")]
fn mile_to_feet(val f64) -> (f64, Error) {
    mut err = validate_length(val)
    if err != nil {
        return MIN_LENGTH_VALUE, err
    }
    return val * FEET_PER_MILE, nil
