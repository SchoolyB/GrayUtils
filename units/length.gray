/*********************************
LENGTH CONSTANTS
*********************************/
const CM_PER_METER f64 = 100.0
const METERS_PER_KM f64 = 1000.0
const INCHES_PER_FOOT f64 = 12.0
const FEET_PER_YARD f64 = 3.0
const FEET_PER_MILE f64 = 5280.0
const YARDS_PER_MILE f64 = 1760.0
const CM_PER_INCH f64 = 2.54
const METERS_PER_INCH f64 = 0.0254
const CM_PER_FOOT f64 = 30.48
const METERS_PER_FOOT f64 = 0.3048
const METERS_PER_YARD f64 = 0.9144
const METERS_PER_MILE f64 = 1609.34
const KM_PER_MILE f64 = 1.60934
const INCHES_PER_CM f64 = 0.393701
const INCHES_PER_METER f64 = 39.3701
const FEET_PER_METER f64 = 3.28084
const YARDS_PER_METER f64 = 1.09361
const MILES_PER_KM f64 = 0.621371
const FEET_PER_KM f64 = 3280.84

/*********************************
METRIC TO METRIC CONVERSION FUNCTIONS
*********************************/
#[doc("Converts the passed centimeters(val) to meters")]
fn centimeter_to_meter(val f64) -> f64 {return val / CM_PER_METER}

#[doc("Converts the passed meters(val) to centimeters")]
fn meter_to_centimeter(val f64) -> f64 {return val * CM_PER_METER}

#[doc("Converts the passed meters(val) to kilometers")]
fn meter_to_kilometer(val f64) -> f64 {return val / METERS_PER_KM}

#[doc("Converts the passed kilometers(val) to meters")]
fn kilometer_to_meter(val f64) -> f64 {return val * METERS_PER_KM}


/*********************************
IMPERIAL TO IMPERIAL CONVERSION FUNCTIONS
*********************************/
#[doc("Converts the passed inches(val) to feet")]
fn inch_to_feet(val f64) -> f64 {return val / INCHES_PER_FOOT}

#[doc("Converts the passed feet(val) to inches")]
fn foot_to_inch(val f64) -> f64 {return val * INCHES_PER_FOOT}

#[doc("Converts the passed feet(val) to yards")]
fn feet_to_yard(val f64) -> f64 {return val / FEET_PER_YARD}

#[doc("Converts the passed yards(val) to feet")]
fn yard_to_feet(val f64) -> f64 {return val * FEET_PER_YARD}

#[doc("Converts the passed yards(val) to miles")]
fn yard_to_mile(val f64) -> f64 {return val / YARDS_PER_MILE}

#[doc("Converts the passed miles(val) to yards")]
fn mile_to_yard(val f64) -> f64 {return val * YARDS_PER_MILE}

#[doc("Converts the passed feet(val) to miles")]
fn feet_to_mile(val f64) -> f64 {return val / FEET_PER_MILE}

#[doc("Converts the passed miles(val) to feet")]
fn mile_to_feet(val f64) -> f64 {return val * FEET_PER_MILE}


/*********************************
IMPERIAL TO METRIC CONVERSION FUNCTIONS
*********************************/
#[doc("Converts the passed inches(val) to centimeters")]
fn inch_to_centimeter(val f64) -> f64 {return val * CM_PER_INCH}

#[doc("Converts the passed inches(val) to meters")]
fn inch_to_meter(val f64) -> f64 {return val * METERS_PER_INCH}

#[doc("Converts the passed feet(val) to meters")]
fn feet_to_meter(val f64) -> f64 {return val * METERS_PER_FOOT}

#[doc("Converts the passed feet(val) to centimeters")]
fn feet_to_centimeter(val f64) -> f64 {return val * CM_PER_FOOT}

#[doc("Converts the passed yards(val) to meters")]
fn yard_to_meter(val f64) -> f64 {return val * METERS_PER_YARD}

#[doc("Converts the passed miles(val) to kilometers")]
fn mile_to_kilometer(val f64) -> f64 {return val * KM_PER_MILE}

#[doc("Converts the passed miles(val) to meters")]
fn mile_to_meter(val f64) -> f64 {return val * METERS_PER_MILE}


/*********************************
METRIC TO IMPERIAL CONVERSION FUNCTIONS
*********************************/
#[doc("Converts the passed centimeters(val) to inches")]
fn centimeter_to_inch(val f64) -> f64 {return val * INCHES_PER_CM}

#[doc("Converts the passed meters(val) to inches")]
fn meter_to_inch(val f64) -> f64 {return val * INCHES_PER_METER}

#[doc("Converts the passed meters(val) to feet")]
fn meter_to_feet(val f64) -> f64 {return val * FEET_PER_METER}

#[doc("Converts the passed meters(val) to yards")]
fn meter_to_yard(val f64) -> f64 {return val * YARDS_PER_METER}

#[doc("Converts the passed kilometers(val) to miles")]
fn kilometer_to_mile(val f64) -> f64 {return val * MILES_PER_KM}

#[doc("Converts the passed kilometers(val) to feet")]
fn kilometer_to_feet(val f64) -> f64 {return val * FEET_PER_KM}
