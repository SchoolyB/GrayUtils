import @math

//INTERNAL CONSTANTS
private const MIN_LENGTH_VALUE f64 = 0.0
private const MAX_LENGTH_VALUE f64 = 1.0e300

/*********************************
LENGTH CONSTANTS
*********************************/
const CM_PER_METER f64 = 100.0
const METERS_PER_KM f64 = 1000.0
const INCHES_PER_FOOT f64 = 12.0
const FEET_PER_YARD f64 = 3.0
const FEET_PER_MILE f64 = 5280.0
const YARDS_PER_MILE f64 = 1760.0
const CM_PER_INCH f64 = 2.54
const METERS_PER_INCH f64 = 0.0254
const CM_PER_FOOT f64 = 30.48
const METERS_PER_FOOT f64 = 0.3048
const METERS_PER_YARD f64 = 0.9144
const METERS_PER_MILE f64 = 1609.34
const KM_PER_MILE f64 = 1.60934
const INCHES_PER_CM f64 = 0.393701
const INCHES_PER_METER f64 = 39.3701
const FEET_PER_METER f64 = 3.28084
const YARDS_PER_METER f64 = 1.09361
const MILES_PER_KM f64 = 0.621371
const FEET_PER_KM f64 = 3280.84

#error_code
private const LengthErrorCodes enum {
    LENGTH_VAL_NEGATIVE
    LENGTH_VAL_NOT_A_NUMBER
    LENGTH_VAL_INFINITE
    LENGTH_VAL_TOO_LARGE
}

// Returns an error when val is not a valid length
private fn validate_length(val f64) -> Error {
    if math.is_nan(val) {
        return error(.LENGTH_VAL_NOT_A_NUMBER, "Value is not a number")
    }
    if math.is_infinite(val) {
        return error(.LENGTH_VAL_INFINITE, "Value is infinite")
    }
    if val < MIN_LENGTH_VALUE {
        return error(.LENGTH_VAL_NEGATIVE, "Value ${val} is negative, min is ${MIN_LENGTH_VALUE}")
    }
    if val > MAX_LENGTH_VALUE {
        return error(.LENGTH_VAL_TOO_LARGE, "Value ${val} too large, max is ${MAX_LENGTH_VALUE}")
    }
    return nil
}

/*********************************
METRIC TO METRIC CONVERSION FUNCTIONS
*********************************/
#[doc("Converts the passed centimeters(val) to meters")]
fn centimeter_to_meter(val f64) -> (f64, Error) {
    mut err = validate_length(val)
    if err != nil {
        return MIN_LENGTH_VALUE, err
    }
    return val / CM_PER_METER, nil
}

#[doc("Converts the passed meters(val) to centimeters")]
fn meter_to_centimeter(val f64) -> (f64, Error) {
    mut err = validate_length(val)
    if err != nil {
        return MIN_LENGTH_VALUE, err
    }
    return val * CM_PER_METER, nil
}

#[doc("Converts the passed meters(val) to kilometers")]
fn meter_to_kilometer(val f64) -> (f64, Error) {
    mut err = validate_length(val)
    if err != nil {
        return MIN_LENGTH_VALUE, err
    }
    return val / METERS_PER_KM, nil
}

#[doc("Converts the passed kilometers(val) to meters")]
fn kilometer_to_meter(val f64) -> (f64, Error) {
    mut err = validate_length(val)
    if err != nil {
        return MIN_LENGTH_VALUE, err
    }
    return val * METERS_PER_KM, nil
}


/*********************************
IMPERIAL TO IMPERIAL CONVERSION FUNCTIONS
*********************************/
