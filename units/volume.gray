/*********************************
IMPERIAL TO METRIC CONVERSION FUNCTIONS
*********************************/
#[doc("Converts the passed fluid ounces(val) to milliliters")]
fn convert_fluid_ounce_to_milliliter(val f64) -> (f64, Error) {
    mut err = validate_volume(val)
    if err != nil {
        return MIN_VOLUME_VALUE, err
    }
    return val * ML_PER_FL_OZ, nil
}

#[doc("Converts the passed fluid ounces(val) to liters")]
fn convert_fluid_ounce_to_liter(val f64) -> (f64, Error) {
    mut err = validate_volume(val)
    if err != nil {
        return MIN_VOLUME_VALUE, err
    }
    return val * ML_PER_FL_OZ / ML_PER_LITER, nil
}

#[doc("Converts the passed cups(val) to milliliters")]
fn convert_cup_to_milliliter(val f64) -> (f64, Error) {
    mut err = validate_volume(val)
    if err != nil {
        return MIN_VOLUME_VALUE, err
    }
    return val * ML_PER_CUP, nil
}

#[doc("Converts the passed cups(val) to liters")]
fn convert_cup_to_liter(val f64) -> (f64, Error) {
    mut err = validate_volume(val)
    if err != nil {
        return MIN_VOLUME_VALUE, err
    }
    return val * ML_PER_CUP / ML_PER_LITER, nil
}

#[doc("Converts the passed pints(val) to liters")]
fn convert_pint_to_liter(val f64) -> (f64, Error) {
    mut err = validate_volume(val)
    if err != nil {
        return MIN_VOLUME_VALUE, err
    }
    return val * LITERS_PER_PINT, nil
}

#[doc("Converts the passed quarts(val) to liters")]
fn convert_quart_to_liter(val f64) -> (f64, Error) {
    mut err = validate_volume(val)
    if err != nil {
        return MIN_VOLUME_VALUE, err
    }
    return val * LITERS_PER_QUART, nil
