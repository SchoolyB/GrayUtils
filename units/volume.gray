#[doc("Converts the passed gallons(val) to liters")]
fn convert_gallon_to_liter(val f64) -> (f64, Error) {
    mut err = validate_volume(val)
    if err != nil {
        return MIN_VOLUME_VALUE, err
    }
    return val * LITERS_PER_GALLON, nil
}

#[doc("Converts the passed gallons(val) to milliliters")]
fn convert_gallon_to_milliliter(val f64) -> (f64, Error) {
    mut err = validate_volume(val)
    if err != nil {
        return MIN_VOLUME_VALUE, err
    }
    return val * LITERS_PER_GALLON * ML_PER_LITER, nil
}


/*********************************
METRIC TO IMPERIAL CONVERSION FUNCTIONS
*********************************/
#[doc("Converts the passed milliliters(val) to fluid ounces")]
fn convert_milliliter_to_fluid_ounce(val f64) -> (f64, Error) {
    mut err = validate_volume(val)
    if err != nil {
        return MIN_VOLUME_VALUE, err
    }
    return val * FL_OZ_PER_ML, nil
