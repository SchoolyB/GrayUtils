import @math

//INTERNAL CONSTANTS
private const MIN_VOLUME_VALUE f64 = 0.0
private const MAX_VOLUME_VALUE f64 = 1.0e300

/*********************************
VOLUME CONSTANTS
*********************************/
const ML_PER_LITER f64 = 1000.0
const LITERS_PER_CUBIC_METER f64 = 1000.0
const FL_OZ_PER_CUP f64 = 8.0
const CUPS_PER_PINT f64 = 2.0
const PINTS_PER_QUART f64 = 2.0
const QUARTS_PER_GALLON f64 = 4.0
const FL_OZ_PER_GALLON f64 = 128.0
const ML_PER_FL_OZ f64 = 29.5735
const ML_PER_CUP f64 = 236.588
const LITERS_PER_PINT f64 = 0.473176
const LITERS_PER_QUART f64 = 0.946353
const LITERS_PER_GALLON f64 = 3.78541
const FL_OZ_PER_ML f64 = 0.033814
const FL_OZ_PER_LITER f64 = 33.814
const CUPS_PER_LITER f64 = 4.22675
const PINTS_PER_LITER f64 = 2.11338
const QUARTS_PER_LITER f64 = 1.05669
const GALLONS_PER_LITER f64 = 0.264172

#error_code
private const VolumeErrorCodes enum {
    VOLUME_VAL_NEGATIVE
    VOLUME_VAL_NOT_A_NUMBER
    VOLUME_VAL_INFINITE
    VOLUME_VAL_TOO_LARGE
}

// Returns an error when val is not a valid volume
private fn validate_volume(val f64) -> Error {
    if math.is_nan(val) {
        return error(.VOLUME_VAL_NOT_A_NUMBER, "Value is not a number")
    }
    if math.is_infinite(val) {
        return error(.VOLUME_VAL_INFINITE, "Value is infinite")
    }
    if val < MIN_VOLUME_VALUE {
        return error(.VOLUME_VAL_NEGATIVE, "Value ${val} is negative, min is ${MIN_VOLUME_VALUE}")
    }
    if val > MAX_VOLUME_VALUE {
        return error(.VOLUME_VAL_TOO_LARGE, "Value ${val} too large, max is ${MAX_VOLUME_VALUE}")
    }
    return nil
}

/*********************************
METRIC TO METRIC CONVERSION FUNCTIONS
*********************************/
#[doc("Converts the passed milliliters(val) to liters")]
fn convert_milliliter_to_liter(val f64) -> (f64, Error) {
    mut err = validate_volume(val)
    if err != nil {
        return MIN_VOLUME_VALUE, err
    }
    return val / ML_PER_LITER, nil
}

#[doc("Converts the passed liters(val) to milliliters")]
fn convert_liter_to_milliliter(val f64) -> (f64, Error) {
    mut err = validate_volume(val)
    if err != nil {
        return MIN_VOLUME_VALUE, err
    }
    return val * ML_PER_LITER, nil
}

#[doc("Converts the passed liters(val) to cubic meters")]
fn convert_liter_to_cubic_meter(val f64) -> (f64, Error) {
    mut err = validate_volume(val)
    if err != nil {
        return MIN_VOLUME_VALUE, err
    }
    return val / LITERS_PER_CUBIC_METER, nil
}

#[doc("Converts the passed cubic meters(val) to liters")]
fn convert_cubic_meter_to_liter(val f64) -> (f64, Error) {
    mut err = validate_volume(val)
    if err != nil {
        return MIN_VOLUME_VALUE, err
    }
    return val * LITERS_PER_CUBIC_METER, nil
}


