private const BASE_1000 f64 = 1000.0 //INTERNAL
private const BASE_1024 f64 = 1024.0 //INTERNAL

/*********************************
DATA CONSTANTS
*********************************/
// Decimal (SI) units using base 1000
// Reference: https://en.wikipedia.org/wiki/International_System_of_Units
const BYTES_PER_KB f64 = BASE_1000
const KB_PER_MB f64 = BASE_1000
const MB_PER_GB f64 = BASE_1000
const GB_PER_TB f64 = BASE_1000
const TB_PER_PB f64 = BASE_1000
const BYTES_PER_MB f64 = 1000000.0
const BYTES_PER_GB f64 = 1000000000.0
const BYTES_PER_TB f64 = 1000000000000.0
const BYTES_PER_PB f64 = 1000000000000000.0

// Binary (IEC) units using base 1024
// Reference: https://en.wikipedia.org/wiki/International_Electrotechnical_Commission
const BYTES_PER_KIB f64 = BASE_1024
const KIB_PER_MIB f64 = BASE_1024
const MIB_PER_GIB f64 = BASE_1024
const GIB_PER_TIB f64 = BASE_1024
const TIB_PER_PIB f64 = BASE_1024
const BYTES_PER_MIB f64 = 1048576.0
const BYTES_PER_GIB f64 = 1073741824.0
const BYTES_PER_TIB f64 = 1099511627776.0
const BYTES_PER_PIB f64 = 1125899906842624.0

/*********************************
DECIMAL (SI) CONVERSION FUNCTIONS
(1 KB = 1000 bytes)
*********************************/
#[doc("Converts the passed bytes(val) to kilobytes")]
fn byte_to_kilobyte(val f64) -> f64 {return val / BYTES_PER_KB}

#[doc("Converts the passed kilobytes(val) to bytes")]
fn kilobyte_to_byte(val f64) -> f64 {return val * BYTES_PER_KB}

#[doc("Converts the passed kilobytes(val) to megabytes")]
fn kilobyte_to_megabyte(val f64) -> f64 {return val / KB_PER_MB}

#[doc("Converts the passed megabytes(val) to kilobytes")]
fn megabyte_to_kilobyte(val f64) -> f64 {return val * KB_PER_MB}

#[doc("Converts the passed megabytes(val) to gigabytes")]
fn megabyte_to_gigabyte(val f64) -> f64 {return val / MB_PER_GB}

#[doc("Converts the passed gigabytes(val) to megabytes")]
fn gigabyte_to_megabyte(val f64) -> f64 {return val * MB_PER_GB}

#[doc("Converts the passed gigabytes(val) to terabytes")]
fn gigabyte_to_terabyte(val f64) -> f64 {return val / GB_PER_TB}

#[doc("Converts the passed terabytes(val) to gigabytes")]
fn terabyte_to_gigabyte(val f64) -> f64 {return val * GB_PER_TB}

#[doc("Converts the passed terabytes(val) to petabytes")]
fn terabyte_to_petabyte(val f64) -> f64 {return val / TB_PER_PB}

#[doc("Converts the passed petabytes(val) to terabytes")]
fn petabyte_to_terabyte(val f64) -> f64 {return val * TB_PER_PB}


/*********************************
BINARY (IEC) CONVERSION FUNCTIONS
(1 KiB = 1024 bytes)
*********************************/
#[doc("Converts the passed bytes(val) to kibibytes")]
fn byte_to_kibibyte(val f64) -> f64 {return val / BYTES_PER_KIB}

#[doc("Converts the passed kibibytes(val) to bytes")]
fn kibibyte_to_byte(val f64) -> f64 {return val * BYTES_PER_KIB}

#[doc("Converts the passed kibibytes(val) to mebibytes")]
fn kibibyte_to_mebibyte(val f64) -> f64 {return val / KIB_PER_MIB}

#[doc("Converts the passed mebibytes(val) to kibibytes")]
fn mebibyte_to_kibibyte(val f64) -> f64 {return val * KIB_PER_MIB}

#[doc("Converts the passed mebibytes(val) to gibibytes")]
fn mebibyte_to_gibibyte(val f64) -> f64 {return val / MIB_PER_GIB}

#[doc("Converts the passed gibibytes(val) to mebibytes")]
fn gibibyte_to_mebibyte(val f64) -> f64 {return val * MIB_PER_GIB}

#[doc("Converts the passed gibibytes(val) to tebibytes")]
fn gibibyte_to_tebibyte(val f64) -> f64 {return val / GIB_PER_TIB}

#[doc("Converts the passed tebibytes(val) to gibibytes")]
fn tebibyte_to_gibibyte(val f64) -> f64 {return val * GIB_PER_TIB}

#[doc("Converts the passed tebibytes(val) to pebibytes")]
fn tebibyte_to_pebibyte(val f64) -> f64 {return val / TIB_PER_PIB}

#[doc("Converts the passed pebibytes(val) to tebibytes")]
fn pebibyte_to_tebibyte(val f64) -> f64 {return val * TIB_PER_PIB}


/*********************************
DECIMAL TO BINARY CONVERSION FUNCTIONS
*********************************/
#[doc("Converts the passed kilobytes(val) to kibibytes")]
fn kilobyte_to_kibibyte(val f64) -> f64 {return val * BYTES_PER_KB / BYTES_PER_KIB}

#[doc("Converts the passed megabytes(val) to mebibytes")]
fn megabyte_to_mebibyte(val f64) -> f64 {return val * KB_PER_MB * BYTES_PER_KB / BYTES_PER_KIB / KIB_PER_MIB}

#[doc("Converts the passed gigabytes(val) to gibibytes")]
fn gigabyte_to_gibibyte(val f64) -> f64 {return val * BYTES_PER_GB / BYTES_PER_GIB}

#[doc("Converts the passed terabytes(val) to tebibytes")]
fn terabyte_to_tebibyte(val f64) -> f64 {return val * BYTES_PER_TB / BYTES_PER_TIB}


/*********************************
BINARY TO DECIMAL CONVERSION FUNCTIONS
*********************************/
#[doc("Converts the passed kibibytes(val) to kilobytes")]
fn kibibyte_to_kilobyte(val f64) -> f64 {return val * BYTES_PER_KIB / BYTES_PER_KB}

#[doc("Converts the passed mebibytes(val) to megabytes")]
fn mebibyte_to_megabyte(val f64) -> f64 {return val * BYTES_PER_MIB / BYTES_PER_MB}

#[doc("Converts the passed gibibytes(val) to gigabytes")]
fn gibibyte_to_gigabyte(val f64) -> f64 {return val * BYTES_PER_GIB / BYTES_PER_GB}

#[doc("Converts the passed tebibytes(val) to terabytes")]
fn tebibyte_to_terabyte(val f64) -> f64 {return val * BYTES_PER_TIB / BYTES_PER_TB}
